{
  "name": "adverse-judge",
  "version": "0.30.0",
  "private": true,
  "type": "module",
  "description": "Waves 21-25: identity proof, version recovery, bulk metrics, durable partner outbox, operator readiness",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "demo": "node scripts/build-demo.mjs",
    "verify": "node scripts/verify-db.mjs",
    "backup": "node scripts/backup.mjs",
    "integrations:check": "node scripts/platform-doctor.mjs",
    "integrations:strict": "node scripts/platform-doctor.mjs --require-ready",
    "ops:doctor": "node scripts/operations-doctor.mjs",
    "ops:strict": "node scripts/operations-doctor.mjs --strict-staging",
    "backup:inspect": "node scripts/backup-inspect.mjs",
    "integrations:conformance": "node scripts/partner-conformance.mjs",
    "integrations:audit": "node scripts/integration-doctor-v1.mjs",
    "ops:retention": "node scripts/retention-sweep.mjs",
    "ops:retention:apply": "node scripts/retention-sweep.mjs --apply --confirm-purge",
    "release:verify": "node scripts/verify-release.mjs",
    "audit:verify": "node scripts/verify-governance.mjs",
    "delivery:once": "node scripts/delivery-worker.mjs --once",
    "delivery:preview": "node scripts/delivery-worker.mjs --dry-run",
    "production:doctor": "node scripts/readiness-v030.mjs",
    "production:gates": "node scripts/readiness-v030.mjs --strict"
  }
}
