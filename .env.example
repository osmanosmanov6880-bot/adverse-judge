# Local pilot. Do not commit a populated .env file.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
# JUDGE_DB=data/judge.sqlite

# Disabled by default. Use the secure OpenAI Platform key setup flow.
# Never put keys in browser code, screenshots or chat.
JUDGE_ALLOW_REMOTE_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_REQUEST_LIMIT=50

# Signed handoff only after verifying the receiving platform contract.
# Use a high-entropy server-only secret of at least 32 characters.
HANDOFF_SECRET=
# PLATFORM_A_CREDENTIAL=

# 0.3: optional operator-supplied platform manifest
# JUDGE_PLATFORMS_FILE=/private/path/platforms.json
# PLATFORM_A_CREDENTIAL=  # >=20 random chars; never use real secrets in .env.example

# v0.4: public production is NOT supported by local accounts.
# For isolated staging behind separately configured Caddy Basic Auth see deploy/.
# Account sessions/locked logins are stored in SQLite and do not need extra keys.

# Wave 5: optional tamper-evident HMAC ledger. Set BEFORE the first start and keep across upgrades.
# Generate at least 32 high-entropy characters and store them outside source control.
# Never change or lose this value for an existing database.
JUDGE_LEDGER_SECRET=

# WAVE 21: verified email challenge. Without these settings the service refuses
# to issue real verification codes. Use a trusted HTTPS mail gateway; never
# put API credentials or raw verification codes in browser-side code.
# JUDGE_MAIL_WEBHOOK_URL=https://mailer.example.com/judge/send
# JUDGE_MAIL_WEBHOOK_KEY=SET_A_PRIVATE_SERVER_ONLY_SECRET_AT_LEAST_20_CHARACTERS
# JUDGE_REQUIRE_VERIFIED_EMAIL=0

# WAVE 24: verified partner contract. Configure A–G separately in
# JUDGE_PLATFORMS_FILE; the examples are NOT configured integrations.
# HANDOFF_SECRET=<32+ character secret from secure secret store>
# PARTNER_A_DELIVERY_HMAC=<32+ character secret distinct from callback key>
# PARTNER_A_CALLBACK_CREDENTIAL=<20+ character server-only credential>
# For a real platform manifest: {"id":"A","mode":"api","verified":true,
#   "deliveryUrl":"https://real-partner.example.com/judge/ingest",
#   "deliveryKeyEnv":"PARTNER_A_DELIVERY_HMAC",
#   "credentialEnv":"PARTNER_A_CALLBACK_CREDENTIAL",
#   "confirmedEvents":["asset_created"]}
# None of these comments authorize calling a real URL. Sign-off and contract
# conformance against an actual partner are required first.

# WAVE 25: path of a recently verified local backup manifest (*.sqlite.json).
# Its presence alone does not pass readiness: file SHA and restore checks run.
# JUDGE_LAST_BACKUP_MANIFEST=/secure/backup/JUDGE-2026.sqlite.json
